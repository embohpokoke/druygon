[Unit]
Description=sandboxd - sandboxed code execution daemon for Druygon
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/mahendra/sandboxd/sandboxd.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
