[Unit]
Description=sandboxd - sandboxed code execution daemon for Druygon
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/mahendra/sandboxd/sandboxd.py
Restart=on-failure
RestartSec=3
# NOTE: do NOT add NoNewPrivileges/PrivateTmp here — under Ubuntu's AppArmor
# userns restriction they block bubblewrap from creating namespaces, silently
# downgrading isolation to the rlimits+audit fallback.

[Install]
WantedBy=default.target
